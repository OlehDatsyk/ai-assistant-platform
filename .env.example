# ==============================================================
# AI Assistant Platform - Environment Configuration
# Copy this file to ".env" and fill in your own values.
# Never commit your real .env file.
# ==============================================================

# --- Core app settings ---
APP_NAME=AI Assistant Platform
APP_ENV=development
APP_SECRET_KEY=
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# --- Auth ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- AI Providers (set at least one) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Web Search (optional) ---
TAVILY_API_KEY=

# --- Gmail / Calendar (Google OAuth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/oauth/callback

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- Voice ---
OPENAI_TTS_MODEL=tts-1
OPENAI_STT_MODEL=whisper-1

# --- Automation webhooks (optional outbound URLs) ---
N8N_WEBHOOK_URL=
ZAPIER_WEBHOOK_URL=
MAKE_WEBHOOK_URL=

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60
